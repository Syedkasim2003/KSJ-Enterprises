# EmailJS Configuration
# Sign up at https://www.emailjs.com/ to get your keys

# EmailJS Service ID (e.g., service_xxxxxxx)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id

# EmailJS Admin Notification Template ID (e.g., template_xxxxxxx)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id

# EmailJS Public Key (Account > Public Key)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# (Optional) EmailJS Auto-Reply Template ID for visitors
NEXT_PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id
